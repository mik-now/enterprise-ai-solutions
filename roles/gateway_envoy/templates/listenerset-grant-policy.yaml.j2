{#
gateway_envoy | ListenerSet mode: a ListenerSet on the platform Gateway may publish
only hosts granted to its namespace (annotation gateway_hostnames_annotation),
HTTPS on :443 only, for routes from its own namespace only. Namespaces are
cluster-scoped, so a tenant cannot grant itself another tenant's host.
Only spec changes are checked, so a revoked grant does not block metadata
updates (finalizers) on an existing ListenerSet.
#}
apiVersion: admissionregistration.k8s.io/v1
kind: ValidatingAdmissionPolicy
metadata:
  name: gateway-listenerset-host-grant
  labels: {{ ownership_labels | default({}) | to_json }}
spec:
  failurePolicy: Fail
  matchConstraints:
    resourceRules:
      - apiGroups: ["gateway.networking.k8s.io"]
        apiVersions: ["v1"]
        operations: ["CREATE", "UPDATE"]
        resources: ["listenersets"]
  matchConditions:
    - name: platform-gateway
      expression: >-
        object.spec.parentRef.name == {{ gateway_name | to_json }} &&
        (has(object.spec.parentRef.namespace) ? object.spec.parentRef.namespace : object.metadata.namespace)
          == {{ gateway_namespace | to_json }}
    - name: spec-changed
      expression: "oldObject == null || object.spec != oldObject.spec"
  variables:
    - name: granted
      expression: >-
        has(namespaceObject.metadata.annotations) &&
        {{ gateway_hostnames_annotation | to_json }} in namespaceObject.metadata.annotations
          ? namespaceObject.metadata.annotations[{{ gateway_hostnames_annotation | to_json }}].split(',').map(h, h.trim())
          : []
  validations:
    - expression: "object.spec.listeners.all(l, has(l.hostname) && l.hostname in variables.granted)"
      messageExpression: >-
        "ListenerSet '" + object.metadata.namespace + "/" + object.metadata.name +
        "' publishes a host not granted to its namespace. Granted: [" + variables.granted.join(", ") + "]."
      reason: Forbidden
    - expression: "object.spec.listeners.all(l, l.protocol == 'HTTPS' && l.port == 443)"
      message: "ListenerSet listeners on the platform Gateway must be HTTPS on port 443."
      reason: Forbidden
    - expression: >-
        object.spec.listeners.all(l, !has(l.allowedRoutes) || !has(l.allowedRoutes.namespaces) ||
          !has(l.allowedRoutes.namespaces.from) || l.allowedRoutes.namespaces.from == 'Same')
      message: "ListenerSet listeners on the platform Gateway may only admit routes from their own namespace."
      reason: Forbidden
---
apiVersion: admissionregistration.k8s.io/v1
kind: ValidatingAdmissionPolicyBinding
metadata:
  name: gateway-listenerset-host-grant
  labels: {{ ownership_labels | default({}) | to_json }}
spec:
  policyName: gateway-listenerset-host-grant
  validationActions: ["Deny"]
