{#
gateway_envoy | Gateway-wide authentication (auth_provider). Routes that do
their own authentication are exempted by gateway_publish (auth: none).
Foreign: keycloak_* are owned by the keycloak role, keycloak_client_id by the
solution that registers the client.
#}
apiVersion: gateway.envoyproxy.io/v1alpha1
kind: SecurityPolicy
metadata:
  name: gateway-auth
  namespace: {{ gateway_namespace | to_json }}
spec:
  targetRefs:
    - group: gateway.networking.k8s.io
      kind: Gateway
      name: {{ gateway_name | to_json }}
{% if auth_provider == 'keycloak' %}
{%   set _realm = keycloak_realm | default('inference') %}
  jwt:
    providers:
      - name: keycloak
        issuer: {{ ('https://' ~ (keycloak_hostname | default('keycloak.' ~ base_domain_name)) ~ '/realms/' ~ _realm) | to_json }}
        audiences:
          - {{ keycloak_client_id | default('inference-client') | to_json }}
        remoteJWKS:
          uri: {{ ('http://keycloak-service.' ~ (keycloak_namespace | default('keycloak'))
                   ~ '.svc.cluster.local:8080/realms/' ~ _realm ~ '/protocol/openid-connect/certs') | to_json }}
{% elif auth_provider == 'litellm' %}
  extAuth:
    http:
      backendRef:
        name: litellm
        namespace: {{ litellm_namespace | default('litellm') | to_json }}
        port: 4000
      headersToBackend:
        - Authorization
      path: /key/verify
{% endif %}
