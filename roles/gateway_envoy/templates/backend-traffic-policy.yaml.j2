{# gateway_envoy | default request timeout for every route on the Gateway (routes may override). #}
apiVersion: gateway.envoyproxy.io/v1alpha1
kind: BackendTrafficPolicy
metadata:
  name: gateway-default-timeout
  namespace: {{ gateway_namespace | to_json }}
spec:
  targetRefs:
    - group: gateway.networking.k8s.io
      kind: Gateway
      name: {{ gateway_name | to_json }}
  timeout:
    http:
      requestTimeout: {{ gateway_request_timeout | to_json }}
      connectionIdleTimeout: {{ gateway_request_timeout | to_json }}
